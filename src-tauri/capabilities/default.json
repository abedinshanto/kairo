{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: core IPC, notifications, and save dialogs. File writes are limited to paths the user picks in a save dialog.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "notification:default",
    "dialog:allow-save",
    "dialog:allow-ask",
    "dialog:allow-message",
    "fs:allow-write-file",
    "core:window:allow-start-dragging"
  ]
}
